{
  "buildCommand": "cd .. && yarn install && cd credshield-ui && yarn build",
  "outputDirectory": "dist",
  "installCommand": "echo 'skip'",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/keys/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    },
    {
      "source": "/zkir/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
